        <mxCell id="re6" value="SafePtr 로 참조" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#82b366;" edge="1" parent="1" source="obj" target="comp"><mxGeometry relative="1" as="geometry" /></mxCell>
