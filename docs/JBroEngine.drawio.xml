        <mxCell id="obj" value="&lt;b&gt;JBro::GameObject&lt;/b&gt;　: GameInstance, EnableSafeFromThis&lt;br&gt;&lt;br&gt;&lt;b&gt;Transform2D Local ／ WorldTransform2D World&lt;/b&gt;　　&lt;font color=&quot;#b85450&quot;&gt;← 컴포넌트가 아니라 멤버&lt;/font&gt;&lt;br&gt;&lt;b&gt;SafePtr&amp;lt;GameObject&amp;gt; m_parent ／ m_children&lt;/b&gt;　　&lt;font color=&quot;#b85450&quot;&gt;← 계층도 멤버&lt;/font&gt;&lt;br&gt;SafePtr&amp;lt;Layer&amp;gt; m_layer　　&lt;font color=&quot;#666666&quot;&gt;GetLayerIndex() O(1)&lt;/font&gt;&lt;br&gt;&lt;b&gt;vector&amp;lt;SafePtr&amp;lt;ComponentBase&amp;gt;&amp;gt; m_components&lt;/b&gt;　&lt;font color=&quot;#666666&quot;&gt;논리 소유&lt;/font&gt;&lt;br&gt;Name ／ Tag ／ Flags ／ &lt;b&gt;InstanceId&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="600" height="140" as="geometry" />
