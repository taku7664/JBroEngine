<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    JBro Script Editor 의 디버그 어댑터다(D-319). 엔진 모듈은 JBroCore(값 타입과 그 할당자)만 링크하고, 나머지는 DbgEng·Windows API 다.
    산출물은 엔진 빌드 폴더 아래 `DebugAdapter\` 다. 에디터 실행 파일 옆에 두지 않는다 - 함께 두는 dbghelp.dll 이 에디터가 싣는 것을 바꾼다.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{1a000035-0000-4000-8000-0000000db9ad}</ProjectGuid>
    <RootNamespace>JBroDebugAdapter</RootNamespace>
    <ProjectName>JBroDebugAdapter</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\JBroEngine\JBro.Common.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <OutDir>$(JBroBuildDir)$(Platform)\$(Configuration)\DebugAdapter\</OutDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(JBroModulesDir)JBroCore\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>dbgeng.lib;dbghelp.lib;oleaut32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="Source\**\*.cpp" />
    <ClInclude Include="Source\**\*.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(JBroModulesDir)JBroCore\JBroCore.vcxproj">
      <Project>{1a000001-0000-4000-8000-00000000c0de}</Project>
    </ProjectReference>
  </ItemGroup>
  <!-- 재배포용 DbgEng(Windows SDK 의 REDIST 목록 "Debugging Tools for Windows")과 JBro 값 타입의 natvis 를 실행 파일 옆에 둔다. -->
  <ItemGroup>
    <!-- `x64\` 가 아니라 `amd64\` 다 - 리포의 .gitignore 가 `x64/` 폴더를 무시해 DLL 이 커밋에서 빠졌다. -->
    <CopyFileToFolders Include="ThirdParty\DbgEng\amd64\*.dll" />
    <CopyFileToFolders Include="$(JBroRoot)JBro.natvis" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
