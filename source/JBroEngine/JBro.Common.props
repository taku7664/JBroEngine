<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    모든 JBro 모듈이 공유하는 빌드 설정.
    모듈별 vcxproj 는 이름, 구성 타입, 의존 모듈만 정의하고 나머지는 여기서 상속한다.
  -->
  <PropertyGroup Label="JBroPaths">
    <JBroRoot>$(MSBuildThisFileDirectory)</JBroRoot>
    <JBroModulesDir>$(JBroRoot)Modules\</JBroModulesDir>
    <JBroBuildDir>$(JBroRoot)Build\</JBroBuildDir>
    <!-- 외부 라이브러리는 소스째로 여기 있다. ThirdParty/README.md 참조. -->
    <JBroThirdPartyDir>$(JBroRoot)ThirdParty\</JBroThirdPartyDir>
    <!-- 네트워크는 별도 프로젝트다(D-122). 엔진이 그것을 참조하고, 그것은 엔진의 Core·Runtime 만 참조한다. -->
    <JBroNetworkDir>$(JBroRoot)..\JBroNetwork\JBroNetwork\</JBroNetworkDir>
    <!--
      miniaudio 의 설정 매크로(D-198). **구현 번역 단위(ThirdParty/miniaudio/miniaudio.cpp)와 헤더를 보는 모든 모듈이
      같은 값을 받아야 한다** - ma_engine 같은 구조체의 모양이 이 매크로에 따라 달라진다. 그래서 여기 한 곳에 둔다.
      리소스 매니저는 파일을 스스로 열고 작업 스레드를 띄우므로 끈다(ProjectRule §2). 백엔드는 쓰는 것만 남긴다 -
      Windows 는 WASAPI, 웹은 Web Audio, 장치 없는 자리(테스트)는 null.
    -->
    <JBroMiniaudioDefines>MA_NO_RESOURCE_MANAGER;MA_NO_ENCODING;MA_NO_GENERATION;MA_ENABLE_ONLY_SPECIFIC_BACKENDS;MA_ENABLE_WASAPI;MA_ENABLE_WEBAUDIO;MA_ENABLE_NULL</JBroMiniaudioDefines>
  </PropertyGroup>

  <PropertyGroup Label="JBroScriptTarget">
    <JBroScriptDimension Condition="'$(JBroScriptDimension)' == ''">2D</JBroScriptDimension>
    <!--
      스크립트 타깃이 받는 include 경로. 선택한 차원의 Tier S 모듈만 넣는다.
      시스템·렌더 추출 같은 실행 계층을 여기에 넣으면 사용자 코드가 그것을 볼 수 있게 된다.
    -->
    <JBroScriptFrameworkIncludes Condition="'$(JBroScriptDimension)' == '2D'">$(JBroModulesDir)JBroFramework2D\Include</JBroScriptFrameworkIncludes>
    <JBroScriptFrameworkIncludes Condition="'$(JBroScriptDimension)' == '3D'">$(JBroModulesDir)JBroFramework3D\Include</JBroScriptFrameworkIncludes>
    <!--
      호스트가 추가로 받는 실행 계층 경로. 게임 호스트는 선택한 차원의 Framework 를 직접 생성한다.
      Framework3D 는 아직 시스템이 없어 한 모듈이며, 생기면 2D 와 같은 방식으로 나눈다.
    -->
    <JBroHostFrameworkIncludes Condition="'$(JBroScriptDimension)' == '2D'">$(JBroModulesDir)JBroFramework2DSystem\Include</JBroHostFrameworkIncludes>
    <JBroHostFrameworkIncludes Condition="'$(JBroScriptDimension)' == '3D'">$(JBroModulesDir)JBroFramework3DSystem\Include</JBroHostFrameworkIncludes>
    <!-- 스크립트 타깃이 받는 전체 include 집합. JBro.Script.props 와 스크립트 프로브가 공유한다. -->
    <!-- 스크립트 타깃임을 헤더가 알아볼 수 있게 하는 표식이다. Tier S 헤더 중
         프렐류드를 거쳐야만 하는 것들이 이 값을 보고 직접 include 를 거절한다. -->
    <JBroScriptTargetDefines>JBRO_SCRIPT_TARGET</JBroScriptTargetDefines>
    <JBroScriptIncludes>$(JBroModulesDir)JBroCore\Include;$(JBroModulesDir)JBroRuntime\Include;$(JBroModulesDir)JBroAssetTypes\Include;$(JBroNetworkDir)Include;$(JBroScriptFrameworkIncludes)</JBroScriptIncludes>
  </PropertyGroup>

  <PropertyGroup Label="JBroVersion">
    <!--
      엔진 버전이다. **여기가 원본이고 다른 곳에 옮겨 적지 않는다**(D-101).
      실행 파일의 버전 리소스가 이 값을 받고, 런처는 그 리소스를 읽어 프로젝트의
      `EngineVersion` 과 맞춘다. 올릴 때는 이 세 줄만 바꾼다.
    -->
    <JBroVersionMajor>0</JBroVersionMajor>
    <JBroVersionMinor>1</JBroVersionMinor>
    <JBroVersionPatch>0</JBroVersionPatch>
    <JBroVersion>$(JBroVersionMajor).$(JBroVersionMinor).$(JBroVersionPatch)</JBroVersion>
  </PropertyGroup>

  <PropertyGroup Label="JBroToolset">
    <PlatformToolset>v145</PlatformToolset>
    <!--
      SDK 버전을 명시적으로 고정한다. `10.0` 은 "이 머신에 깔린 최신 SDK" 라는 뜻이라
      개발자·빌드 서버마다 다른 SDK 로 빌드되고 그 사실이 어디에도 남지 않는다.
      올릴 때는 이 한 줄을 바꾸고 Debug/Release 전체 빌드와 테스트로 확인한다.
    -->
    <WindowsTargetPlatformVersion>10.0.22621.0</WindowsTargetPlatformVersion>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>

  <PropertyGroup>
    <OutDir>$(JBroBuildDir)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(JBroBuildDir)Intermediate\$(Platform)\$(Configuration)\$(ProjectName)\</IntDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <UseDebugLibraries>false</UseDebugLibraries>
    <WholeProgramOptimization>true</WholeProgramOptimization>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!--
        소스도 실행 문자열도 UTF-8 이다.
        없으면 MSVC 가 좁은 문자열 리터럴을 시스템 코드 페이지(한국어 윈도우에서는
        949)로 인코딩한다. 우리 코드가 글자를 넘기는 곳은 전부 UTF-8 을 기대한다 -
        ImGui 도, .jcanvas 도, NameTable 도. 그래서 한글이 섞인 리터럴이 화면에서
        깨지고, 컴파일러는 경고만 하고 지나간다.
        기존 엔진도 같은 이유로 /utf-8 을 켰다.
      -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!--
        WIN32_LEAN_AND_MEAN 은 예전 framework.h 가 담당했다.
        pch 를 걷어내면서 모든 모듈에 공통으로 적용되도록 여기로 옮겼다.
      -->
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- 코드가 엔진 버전을 알아야 할 때(새 프로젝트의 `EngineVersion`, D-160) 위의 세 줄에서 받는다.
           `JBro/Core/Version.h` 가 글자로 바꾼다. 코드에 버전을 옮겨 적지 않는다(D-101). -->
      <PreprocessorDefinitions>JBRO_VERSION_MAJOR=$(JBroVersionMajor);JBRO_VERSION_MINOR=$(JBroVersionMinor);JBRO_VERSION_PATCH=$(JBroVersionPatch);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Debug'">_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <PreprocessorDefinitions Condition="'$(Configuration)'=='Release'">NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <ClCompile Condition="'$(Configuration)'=='Release'">
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
</Project>
