<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    사용자 게임 스크립트 프로젝트의 컴파일·링크 설정이다(cpp-script-plan §3.3, D-266). `Microsoft.Cpp.props` 뒤, `Microsoft.Cpp.targets` 앞에서
    import 된다 - 시험 DLL(`Tests/ScriptModuleProbe`)의 ItemDefinitionGroup 과 같은 자리다.

    include 는 스크립트 SDK 사본(`JBroScriptSdkIncludes`)뿐이다. 스크립트 입구에서 닿는 헤더만 주석 없이 들어 있어, 그 밖의 엔진 헤더를
    include 하면 C1083 이고 컴포넌트 데이터 헤더는 핸들을 쓰라는 `#error` 다(ProjectRule §11).
    링크 목록은 스크립트 DLL 이 부르는 모듈이다. 모듈이 늘면 여기만 고친다.
  -->
  <PropertyGroup>
    <JBroGameScriptFrameworkLib Condition="'$(JBroScriptDimension)' == '2D'">JBroFramework2D.lib</JBroGameScriptFrameworkLib>
    <JBroGameScriptFrameworkLib Condition="'$(JBroScriptDimension)' == '3D'">JBroFramework3D.lib</JBroGameScriptFrameworkLib>
    <!--
      **PDB 는 빌드마다 다른 이름이다**(D-319). 디버거가 붙어 있으면 지금 PDB 를 쥐고 있어, 같은 이름으로 다시 쓰면 링커가 LNK1201 로 실패하고
      DLL 까지 지웠다. 이름에 빌드 시각을 붙이면 새 PDB 는 늘 새 파일이고, DLL 이 새 이름을 가리키므로 디버거는 새 복사본에서 새 PDB 를 읽는다.
      이 이름이 링크 명령줄에 들어가므로 바뀐 것이 없어도 빌드마다 다시 링크한다 - 스크립트 DLL 은 작아 그 값을 치른다.
    -->
    <JBroGameScriptPdbStamp>$([System.DateTime]::Now.ToString("yyyyMMddHHmmssfff"))</JBroGameScriptPdbStamp>
    <JBroCompilerPath>$(JBroBuildDir)$(Platform)\$(Configuration)\JBroc.exe</JBroCompilerPath>
    <JBroGeneratedDirectory>$(IntDir)JBroScript\</JBroGeneratedDirectory>
  </PropertyGroup>

  <!-- Keep the generated file in the engine's intermediate directory; never rewrite user-owned C++ sources. -->
  <ItemGroup>
    <JBroScriptSource Include="$(MSBuildProjectDirectory)\Scripts\**\*.jscript" />
  </ItemGroup>

  <!-- SDK 사본이 없으면 수백 개의 C1083 대신 무엇을 해야 하는지 말한다. -->
  <Target Name="JBroGameScriptCheckSdk" BeforeTargets="ClCompile">
    <Error Condition="!Exists('$(JBroScriptSdkIncludes)\JBro\ScriptAPI.h')"
           Text="The JBro script SDK headers were not found at $(JBroScriptSdkIncludes). Build the engine first." />
  </Target>

  <Target Name="JBroGameScriptValidate" BeforeTargets="ClCompile" Condition="'@(JBroScriptSource)' != ''">
    <Error Condition="'$(JBroScriptDimension)' != '2D'"
           Text="JBroScript C++ generation currently supports only 2D script projects." />
    <Error Condition="!Exists('$(JBroCompilerPath)')"
           Text="JBroc.exe was not found at $(JBroCompilerPath). Build JBroc in the same configuration first." />
  </Target>

  <Target Name="JBroGameScriptGenerate" BeforeTargets="ClCompile" DependsOnTargets="JBroGameScriptValidate"
          Condition="'$(JBroScriptDimension)' == '2D' and ('@(JBroScriptSource)' != '' or Exists('$(JBroGeneratedDirectory)JBroGenerated.files'))">
    <MakeDir Directories="$(JBroGeneratedDirectory)" />
    <Exec Command="&quot;$(JBroCompilerPath)&quot; --emit-project &quot;$(JBroGeneratedDirectory).&quot; --no-module-entry @(JBroScriptSource->'&quot;%(FullPath)&quot;', ' ')"
          StdOutEncoding="UTF-8" StdErrEncoding="UTF-8" />
    <ReadLinesFromFile File="$(JBroGeneratedDirectory)JBroGenerated.items">
      <Output TaskParameter="Lines" ItemName="JBroGeneratedCompileFiles" />
    </ReadLinesFromFile>
    <ItemGroup>
      <ClCompile Include="@(JBroGeneratedCompileFiles->'$(JBroGeneratedDirectory)%(Identity)')" />
    </ItemGroup>
  </Target>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(JBroScriptSdkIncludes);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>$(JBroScriptTargetDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(JBroGameScriptLibDir);$(JBroGameScriptNetworkLibDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>$(JBroGameScriptFrameworkLib);JBroRuntime.lib;JBroCore.lib;JBroAudioTypes.lib;JBroInputTypes.lib;JBroSaveTypes.lib;JBroLocalizationTypes.lib;JBroNetwork.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ProgramDatabaseFile>$(OutDir)$(TargetName).$(JBroGameScriptPdbStamp).pdb</ProgramDatabaseFile>
    </Link>
  </ItemDefinitionGroup>

  <!--
    지난 빌드의 PDB 를 지운다. 디버거가 쥐고 있는 것은 지워지지 않고 남는다 - 다음 빌드에서 다시 지운다. 실패를 경고로 올리지 않는다:
    `빌드 결과` 에 매번 경고가 서면 진짜 경고가 묻힌다. 이름을 바꾸기 전의 `GameScript.pdb` 도 같이 지운다.
  -->
  <Target Name="JBroGameScriptRemoveOldPdbs" BeforeTargets="Link">
    <Exec Command="del /q &quot;$(OutDir)$(TargetName).pdb&quot; &quot;$(OutDir)$(TargetName).*.pdb&quot; 2&gt;nul"
          IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardOutputImportance="low" />
  </Target>

  <!-- 엔진 라이브러리가 없으면 링커의 LNK1181 대신 무엇을 해야 하는지 말한다. -->
  <Target Name="JBroGameScriptCheckEngineBuild" BeforeTargets="Link">
    <Error Condition="!Exists('$(JBroGameScriptLibDir)JBroRuntime.lib')"
           Text="The JBro engine has not been built for $(Configuration)|$(Platform) at $(JBroGameScriptLibDir). Build the engine in the same configuration first." />
  </Target>
</Project>
