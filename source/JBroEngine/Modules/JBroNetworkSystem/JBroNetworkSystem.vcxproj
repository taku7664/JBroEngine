<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    네트워크와 엔진을 잇는 어댑터다(D-122, network-plan §2.1). 트랜스포트·복제 핵심은 별도 프로젝트 `source/JBroNetwork` 에 있고,
    여기에는 캔버스 풀을 복제 풀로 감싸는 어댑터, 수신·송신 GameSystem, 호스트가 소유하는 `NetworkHost` 만 있다.
    의존은 엔진 → 네트워크 한 방향이다. 네트워크 프로젝트는 이 모듈을 모른다.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{1a000017-0000-4000-8000-0000000ae75c}</ProjectGuid>
    <RootNamespace>JBroNetworkSystem</RootNamespace>
    <ProjectName>JBroNetworkSystem</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(SolutionDir)JBro.Common.props" Condition="Exists('$(SolutionDir)JBro.Common.props')" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\JBro.Common.props" Condition="!Exists('$(SolutionDir)JBro.Common.props')" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(JBroModulesDir)JBroNetworkSystem\Include;$(JBroNetworkDir)Include;$(JBroModulesDir)JBroCanvas\Include;$(JBroModulesDir)JBroRuntime\Include;$(JBroModulesDir)JBroCore\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Include\**\*.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Source\**\*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(JBroModulesDir)JBroCore\JBroCore.vcxproj">
      <Project>{1a000001-0000-4000-8000-00000000c0de}</Project>
    </ProjectReference>
    <ProjectReference Include="$(JBroModulesDir)JBroRuntime\JBroRuntime.vcxproj">
      <Project>{1a000006-0000-4000-8000-000000027417}</Project>
    </ProjectReference>
    <ProjectReference Include="$(JBroModulesDir)JBroCanvas\JBroCanvas.vcxproj">
      <Project>{1a00000f-0000-4000-8000-00000000ca47}</Project>
    </ProjectReference>
    <ProjectReference Include="$(JBroNetworkDir)JBroNetwork.vcxproj">
      <Project>{1a000020-0000-4000-8000-0000000ae700}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
