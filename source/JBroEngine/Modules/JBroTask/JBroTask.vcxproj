<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <ProjectGuid>{1a000023-0000-4000-8000-00000000da5c}</ProjectGuid>
    <RootNamespace>JBroTask</RootNamespace>
    <ProjectName>JBroTask</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(SolutionDir)JBro.Common.props" Condition="Exists('$(SolutionDir)JBro.Common.props')" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\JBro.Common.props" Condition="!Exists('$(SolutionDir)JBro.Common.props')" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>StaticLibrary</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <!--
    엔진과 에디터가 함께 쓰는 태스크 관리자다(D-209). Tier E 커널이고 캔버스·스크립트를 모른다.
    JBroCore 만 본다. JBroRuntime 의 include 경로를 받지 않으므로 `Ref<T>`·`GameObjectHandle` 헤더를 넣으면
    컴파일이 실패한다. 스크립트 타깃은 이 모듈의 경로를 받지 않는다(TierProbe 의 Task).
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(JBroModulesDir)JBroTask\Include;$(JBroModulesDir)JBroCore\Include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClInclude Include="Include\**\*.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="Source\**\*.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(JBroModulesDir)JBroCore\JBroCore.vcxproj">
      <Project>{1a000001-0000-4000-8000-00000000c0de}</Project>
      <LinkLibraryDependencies>false</LinkLibraryDependencies>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
