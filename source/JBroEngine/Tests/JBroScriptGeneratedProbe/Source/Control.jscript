enum Mode
{
    Idle
    Active
}

class Counter
{
    public Int value
    public const Int step = 2
    public static Int total = 0

    public fn Counter(Int start)
    {
        value = start
    }

    public static fn Next(const Int amount) -> Int
    {
        total += amount
        return total
    }
}

script ControlProbe
{
    public Int count
    public Int rhsCount
    public Int switchChecks
    public Table<String, Int> scores
    [prop] public Mode mode = Mode.Idle

    public fn HasOwner() -> Bool
    {
        return GetGameObject().valid
    }

    public fn HasTransform() -> Bool
    {
        return GetGameObject().GetComponent<Transform2D>() is not null
    }

    public fn HasTransformSafe() -> Bool
    {
        return GetGameObject()?.GetComponent<Transform2D>() is not null
    }

    public fn DisableOwnerSafe()
    {
        GetGameObject()?.SetActive(false)
    }

    public fn NullFallback() -> Int
    {
        return null ?? 5
    }

    public fn RaiseScores()
    {
        for (key, ref value in scores)
        {
            value += 1
        }
    }

    public fn GenericArray() -> Int
    {
        Array<Int> values = Array<Int>()
        values.Add(3)
        return values[0]
    }

    public fn OwnCount() -> Int
    {
        return this.count
    }

    public fn ScoreByName() -> Int
    {
        return scores["bonus"]
    }

    public fn Brighten() -> Float
    {
        ref Light2D light = GetGameObject().GetComponent<Light2D>()
        light.intensity += NextAmount()
        return light.intensity
    }

    public fn NextAmount() -> Float
    {
        rhsCount += 1
        return 0.5
    }

    public fn RenameOwner()
    {
        GetGameObject().name = "edited"
        GetGameObject().name += "!"
        GetGameObject().active = false
    }

    public fn MoveOwner() -> Float
    {
        ref Transform2D transform = GetGameObject().GetComponent<Transform2D>()
        Vector2 delta
        delta.x = 2.0
        delta.y = 3.0
        transform.position += delta
        return transform.position.x
    }

    public fn UseCounter() -> Int
    {
        Counter counter = Counter(3)
        const Int increment = 1
        return counter.value + counter.step + Counter.Next(increment)
    }

    public fn NextSwitchValue() -> Int
    {
        switchChecks += 1
        return 1
    }

    public fn NextSwitchCase() -> Int
    {
        switchChecks += 1
        return 1
    }

    public fn SwitchScalars() -> Int
    {
        Int result = 0
        String key = "two"
        switch (key)
        {
            case "one" { result += 100 }
            case "two" { result += 2 }
            default { result += 1000 }
        }
        Float fraction = 1.5
        switch (fraction)
        {
            case 1.0, 1.5 { result += 3 }
            default { result += 1000 }
        }
        Bool yes = true
        switch (yes)
        {
            case false { result += 1000 }
            case true { result += 5 }
        }
        switch (NextSwitchValue())
        {
            case NextSwitchCase() { result += 7 }
            default { result += 1000 }
        }
        for (i in 0..3)
        {
            switch (i)
            {
                case 1 { continue }
                default { result += 1 }
            }
        }
        return result + switchChecks * 100
    }

    fn OnPointerDown() override
    {
        Float intensity = Brighten()
        count += 1
    }

    fn OnUpdate() override
    {
        for (i in 0..3)
        {
            count += i
        }
        for (key, value in scores)
        {
            count += value
        }
        switch (mode)
        {
            case Mode.Idle
            {
                count += 1
            }
            case Mode.Active
            {
                count += 2
            }
        }
    }
}
