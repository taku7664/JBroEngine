// jbroc 이 진단 없이 통과시키는데 생성 C++ 이 MSVC 에서 멈추던 모양들이다(Script QA 결함 2). 이 표본은 /W4 /WX 로 컴파일된다.

class NullableHolder
{
    public ref Int count
}

script EmitterShapes
{
    // `Range`·`Clamp` 는 Float 둘을 받는다. 정수·음수·섞인 인자 모두 그대로 써야 한다.
    [range(1, 100)] Int intRange = 10
    [range(0.5, 2.5)] Float floatRange = 1.0
    [range(-10, -1)] Int negativeRange = -5
    [range(-1, 2.5)] Float mixedRange = 0.0
    [clamp(0, 1)] Float clamped = 0.5
    [range(1, 3), category("Stats")] Int withCategory = 2

    ref Transform2D target
    ref GameObject owner
    ref NullableHolder holder
    Table<String, Int> scores

    // `?.` 는 사슬 끝까지 건너뛴다 - 끝이 값·핸들·ref 값일 때 각각.
    fn ValueEnd() -> Float
    {
        return target?.position.y ?? 0.0
    }

    fn HandleEnd() -> ref Transform2D
    {
        ref Transform2D found = owner?.GetComponent<Transform2D>()
        return found
    }

    fn RefValueEnd() -> Int
    {
        return holder?.count ?? 3
    }

    // 출력 인자로 투영한 엔진 함수는 반환값으로 받는다.
    fn Projections() -> Int
    {
        Vector2 origin
        Vector2 down
        down.y = -1.0
        ref RaycastHit2D hit = Physics.Raycast(origin, down, 1.0)
        ref RaycastHit2D circle = Physics.CircleCast(origin, 0.5, down, 1.0)
        Array<RaycastHit2D> hits = Physics.RaycastAll(origin, down, 1.0)
        Rect area
        Array<ref GameObject> boxed = Physics.OverlapBox(area)
        Array<ref GameObject> found = Objects.FindAll("Enemy")
        ref String saved = Save.ReadText("slot")
        ref InputBinding binding = Input.GetActionBinding(1, 0)
        ref Int score = scores.Find("bonus")
        Int total = hits.Size() + boxed.Size() + found.Size() + (score ?? 0)
        if (hit is not null and circle is not null)
        {
            total += 1
        }
        if (saved is not null and binding is not null)
        {
            total += 1
        }
        return total
    }
}
