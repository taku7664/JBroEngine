      <!--
        고치지 않은 외부 소스다(ThirdParty/README.md). 3D 물리 커널이다(physics3d-plan, D-414).
        컴파일하는 목록은 Jolt.cmake 의 기본 목록 그대로다 - ObjectStream 과 GPU 컴퓨트 백엔드(DX12·VK·MTL)는 넣지 않는다.
        JPH_* 매크로는 구조체 모양을 바꾸므로 이 라이브러리와 Jolt 헤더를 보는 모듈이 같은 값을 받아야 한다 - JBro.Common.props 의 JBroJoltDefines 한 곳이다.
      -->
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level1</WarningLevel>
      <TreatWarningAsError>false</TreatWarningAsError>
      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>$(JBroJoltDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
