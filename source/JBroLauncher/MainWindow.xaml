<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="JBro.Launcher.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:JBro.Launcher"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="JBro Launcher">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16" RowSpacing="12">

        <Pivot x:Name="Sections" Grid.Row="0" Grid.RowSpan="2">

            <PivotItem Header="프로젝트">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="프로젝트 추가" Click="OnAddProject" />
                        <Button Content="열기" Click="OnOpenProject" />
                        <Button Content="목록에서 제거" Click="OnRemoveProject" />
                    </StackPanel>

                    <ListView x:Name="ProjectList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:ProjectRow">
                                <Grid ColumnDefinitions="*,Auto" Padding="4,8">
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Path}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Detail}" VerticalAlignment="Center"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="엔진">
                <Grid RowDefinitions="Auto,*" RowSpacing="12">
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                        <Button Content="엔진 폴더 등록" Click="OnAddEngine" />
                        <Button Content="목록에서 제거" Click="OnRemoveEngine" />
                    </StackPanel>

                    <ListView x:Name="EngineList" Grid.Row="1" SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EngineRow">
                                <StackPanel Padding="4,8">
                                    <TextBlock Text="{x:Bind Version}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind Directory}" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

        </Pivot>

        <InfoBar x:Name="Notice" Grid.Row="2" IsOpen="False" IsClosable="True" />

    </Grid>
</Window>
