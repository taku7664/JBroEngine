	"tokenColors": [
		{
			"scope": [
				"comment"
			],
			"settings": {
				"foreground": "#7A8493",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"keyword",
				"storage"
			],
			"settings": {
				"foreground": "#B9BDD8"
			}
		},
		{
			"scope": [
				"entity.name.type",
				"support.type",
				"entity.name.namespace"
			],
			"settings": {
				"foreground": "#BCD0CF"
			}
		},
		{
			"scope": [
				"entity.name.function",
				"support.function"
			],
			"settings": {
				"foreground": "#D5CADB"
			}
		},
		{
			"scope": [
				"string"
			],
			"settings": {
				"foreground": "#B7CDBB"
			}
		},
		{
			"scope": [
				"constant.numeric",
				"constant.language"
			],
			"settings": {
				"foreground": "#D6C8B0"
			}
		},
		{
			"scope": [
				"punctuation",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#AAB3BF"
			}
		}
	],
	"semanticTokenColors": {
		"keyword": "#B9BDD8",
		"type": "#BCD0CF",
		"class": "#BCD0CF",
		"interface": "#BCD0CF",
		"namespace": "#BCD0CF",
		"function": "#D5CADB",
		"method": "#D5CADB",
		"string": "#B7CDBB",
		"number": "#D6C8B0",
		"comment": "#7A8493"
	}
}
