{
	"name": "jbro-languages",
	"displayName": "%displayName%",
	"description": "%description%",
	"publisher": "jbro",
	"version": "0.0.1",
	"private": true,
	"main": "./extension.cjs",
	"l10n": "./l10n",
	"extensionKind": ["workspace"],
	"activationEvents": ["onLanguage:jbroscript"],
	"engines": {
		"vscode": "^1.100.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "jbroscript",
				"aliases": [
					"JBroScript",
					"jbroscript"
				],
				"extensions": [
					".jscript"
				],
				"configuration": "./language-configuration.json"
			},
			{
				"id": "yaml",
				"extensions": [
					".jproject",
					".jcanvas",
					".jprefab"
				]
			}
		],
		"configuration": {
			"title": "JBroScript",
			"properties": {
				"jbro.jbroscript.serverPath": {
					"type": "string",
					"default": "",
					"description": "%serverPath%",
					"scope": "resource"
				},
				"jbro.jbroscript.projectFile": {
					"type": "string",
					"default": "",
					"description": "%projectFile%",
					"scope": "resource"
				}
			}
		},
		"grammars": [
			{
				"language": "jbroscript",
				"scopeName": "source.jscript",
				"path": "./syntaxes/jscript.tmLanguage.json"
			}
		]
	},
	"dependencies": {
		"vscode-languageclient": "10.1.2"
	}
}
