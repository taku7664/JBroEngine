// SYNTAX TEST "source.jscript" "declaration kinds, inheritance, enums, modifiers and fields"
script Knight : ICombatant, IHealable
class Sword : Weapon
{
    public Int Gold = 0
//  ^^^^^^ storage.modifier.jscript
//         ^^^ support.type.primitive.jscript
//             ^^^^ variable.other.definition.jscript
    protected static Int aliveCount = 0
//  ^^^^^^^^^ storage.modifier.jscript
//            ^^^^^^ storage.modifier.jscript
//                       ^^^^^^^^^^ variable.other.definition.jscript
    private const Float Gravity = 9.8
//  ^^^^^^^ storage.modifier.jscript
//          ^^^^^ storage.modifier.jscript
//                ^^^^^ support.type.primitive.jscript
//                      ^^^^^^^ variable.other.definition.jscript
//                                ^^^ constant.numeric.jscript
    ref Transform2D target
//  ^^^ storage.modifier.ref.jscript
//      ^^^^^^^^^^^ entity.name.type.jscript
//                  ^^^^^^ variable.other.definition.jscript
    ref const Array<DropEntry> table
//  ^^^ storage.modifier.ref.jscript
//      ^^^^^ storage.modifier.jscript
//            ^^^^^ support.type.builtin.jscript
//                  ^^^^^^^^^ entity.name.type.jscript
//                             ^^^^^ variable.other.definition.jscript
    Array<ref Enemy> allies
//  ^^^^^ support.type.builtin.jscript
