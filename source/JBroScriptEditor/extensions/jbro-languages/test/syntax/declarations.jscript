//          ^^^^ variable.other.definition.jscript
    EnemyState state = EnemyState.Idle
//  ^^^^^^^^^^ entity.name.type.jscript
//             ^^^^^ variable.other.definition.jscript
//                     ^^^^^^^^^^ - entity.name.type.jscript variable.other.definition.jscript
    LootTable loot = LootTable(8)
//  ^^^^^^^^^ entity.name.type.jscript
//            ^^^^ variable.other.definition.jscript
    String template
//         ^^^^^^^^ variable.other.definition.jscript
    Int override = 0
//      ^^^^^^^^ variable.other.definition.jscript - storage.modifier.override.jscript
    int legacy = 0
//  ^^^ entity.name.type.jscript - support.type.primitive.jscript
}
struct DropEntry
interface ICombatant : IDamageable, IHealable
