@@ -0,0 +1,93 @@
+/* JBro Script Editor reusable native menu bar. */
+
+import { getWindow } from '../../../base/browser/dom.js';
+import { MenuBar, MenuBarMenu } from '../../../base/browser/ui/menu/menubar.js';
+import { ActionRunner } from '../../../base/common/actions.js';
+import { Disposable, DisposableStore, toDisposable } from '../../../base/common/lifecycle.js';
+import { IMenu, IMenuService, MenuId, SubmenuItemAction } from '../../../platform/actions/common/actions.js';
+import { IContextKeyService } from '../../../platform/contextkey/common/contextkey.js';
+import { IKeybindingService } from '../../../platform/keybinding/common/keybinding.js';
+import { INotificationService } from '../../../platform/notification/common/notification.js';
+import { defaultMenuStyles } from '../../../platform/theme/browser/defaultStyles.js';
+
+/** Renders localized submenu contributions without owning product labels or commands. */
+export class JBroMenuBar extends Disposable {
+	private readonly rootMenu: IMenu;
+	private readonly widgetStore = this._register(new DisposableStore());
+	private readonly actionRunner = this._register(new ActionRunner());
+	private widget: MenuBar | undefined;
+	private labels: string[] = [];
+	private visible = true;
+
+	constructor(
+		private readonly container: HTMLElement,
+		menuId: MenuId,
+		@IMenuService menuService: IMenuService,
+		@IContextKeyService contextKeyService: IContextKeyService,
+		@IKeybindingService private readonly keybindingService: IKeybindingService,
+		@INotificationService notificationService: INotificationService
+	) {
+		super();
+		this.container.classList.add('menubar');
+		this.rootMenu = this._register(menuService.createMenu(menuId, contextKeyService, { emitEventsForSubmenuChanges: true }));
+		this._register(this.rootMenu.onDidChange(() => this.render()));
+		this._register(this.keybindingService.onDidUpdateKeybindings(() => this.widget?.update()));
+		this._register(this.actionRunner.onDidRun(event => {
+			if (event.error) {
+				notificationService.error(event.error);
+			}
+		}));
+		const observer = new (getWindow(container).ResizeObserver)(() => this.widget?.update());
+		observer.observe(container);
+		this._register(toDisposable(() => observer.disconnect()));
+		this.render();
+	}
+
+	setVisible(visible: boolean): void {
+		this.visible = visible;
+		if (!visible) {
+			this.widget?.blur();
+		}
+		this.container.style.display = visible && this.labels.length > 0 ? '' : 'none';
+		this.widget?.update({ visibility: visible ? 'visible' : 'hidden' });
+	}
+
+	focus(): void {
+		if (this.visible) {
+			this.widget?.toggleFocus();
+		}
+	}
+
+	private render(): void {
+		const menus: MenuBarMenu[] = this.rootMenu.getActions()
+			.flatMap(([, actions]) => actions)
+			.filter((action): action is SubmenuItemAction => action instanceof SubmenuItemAction)
+			.map(action => ({ label: action.label, actions: [...action.actions] }));
+		const labels = menus.map(menu => menu.label);
+		const sameLabels = labels.length === this.labels.length && labels.every((label, index) => label === this.labels[index]);
+		if (this.widget && sameLabels) {
+			for (const menu of menus) {
+				this.widget.updateMenu(menu);
+			}
+			this.widget.update();
+			return;
+		}
+
+		this.widget?.blur();
+		this.widgetStore.clear();
+		this.widget = undefined;
+		this.labels = labels;
+		this.container.style.display = this.visible && menus.length > 0 ? '' : 'none';
+		if (menus.length === 0) {
+			return;
+		}
+		this.widget = this.widgetStore.add(new MenuBar(this.container, {
+			visibility: this.visible ? 'visible' : 'hidden',
+			enableMnemonics: true,
+			getKeybinding: action => this.keybindingService.lookupKeybinding(action.id),
+			actionRunner: this.actionRunner
+		}, defaultMenuStyles));
+		this.widget.push(menus);
+		this.widget.update();
+	}
+}
